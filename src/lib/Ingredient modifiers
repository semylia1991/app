// Fast lookup index: ingredient name (lowercase) → its modifier rows.
const MODIFIER_INDEX = new Map<string, ModifierRow[]>();
for (const row of INGREDIENT_MODIFIERS) {
  const key = row[0];
  const arr = MODIFIER_INDEX.get(key);
  if (arr) arr.push(row);
  else MODIFIER_INDEX.set(key, [row]);
}

export function getModifierRows(ingredientName: string): ModifierRow[] {
  return MODIFIER_INDEX.get(ingredientName.toLowerCase()) ?? [];
}

/** True if the ingredient has at least one modifier row in the static table. */
export function hasModifiers(ingredientName: string): boolean {
  return MODIFIER_INDEX.has(ingredientName.toLowerCase());
}
